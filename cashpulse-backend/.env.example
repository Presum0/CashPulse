# =====================================================================
# CASHPULSE BACKEND CONFIGURATION
# =====================================================================

# Database Connection URL
# SQLite for local development: sqlite:///./cashpulse.db
# PostgreSQL for production (Supabase / Neon): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./cashpulse.db

# =====================================================================
# PLAID INTEGRATION (SANDBOX TESTING)
# =====================================================================
# Sign up at https://dashboard.plaid.com/signup for sandbox API keys
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_sandbox_secret_here
# Plaid Environment: sandbox | development | production
PLAID_ENV=sandbox

# =====================================================================
# ACCOUNTING & ERP INTEGRATION (XERO / QUICKBOOKS)
# =====================================================================
# Xero Developer Portal: https://developer.xero.com/myapps
XERO_CLIENT_ID=your_xero_client_id_here
XERO_CLIENT_SECRET=your_xero_client_secret_here
XERO_REDIRECT_URI=http://localhost:8000/api/v1/integrations/accounting/callback/xero

# Intuit Developer Portal: https://developer.intuit.com/app/developer/dashboard
QBO_CLIENT_ID=your_qbo_client_id_here
QBO_CLIENT_SECRET=your_qbo_client_secret_here
QBO_REDIRECT_URI=http://localhost:8000/api/v1/integrations/accounting/callback/quickbooks

